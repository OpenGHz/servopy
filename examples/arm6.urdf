<?xml version="1.0"?>
<!-- Synthetic six-axis model for tests and examples; not a hardware description. -->
<robot name="arm6">
  <link name="base"/><link name="l1"/><link name="l2"/><link name="l3"/>
  <link name="l4"/><link name="l5"/><link name="l6"/><link name="tool"/>
  <joint name="j1" type="revolute">
    <parent link="base"/><child link="l1"/><origin xyz="0 0 .1"/>
    <axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" velocity="1.5" effort="10"/>
  </joint>
  <joint name="j2" type="revolute">
    <parent link="l1"/><child link="l2"/><origin xyz="0 0 .1"/>
    <axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" velocity="1.5" effort="10"/>
  </joint>
  <joint name="j3" type="revolute">
    <parent link="l2"/><child link="l3"/><origin xyz=".3 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" velocity="1.5" effort="10"/>
  </joint>
  <joint name="j4" type="revolute">
    <parent link="l3"/><child link="l4"/><origin xyz=".25 0 0"/>
    <axis xyz="1 0 0"/><limit lower="-3.14" upper="3.14" velocity="2" effort="10"/>
  </joint>
  <joint name="j5" type="revolute">
    <parent link="l4"/><child link="l5"/><origin xyz=".05 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" velocity="2" effort="10"/>
  </joint>
  <joint name="j6" type="revolute">
    <parent link="l5"/><child link="l6"/><origin xyz=".05 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" velocity="2" effort="10"/>
  </joint>
  <joint name="tcp" type="fixed">
    <parent link="l6"/><child link="tool"/><origin xyz=".1 0 0"/>
  </joint>
</robot>
